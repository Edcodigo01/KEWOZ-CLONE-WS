# Entorno
NODE_ENV=development

# Servidor
Port=3047
baseUrl=http://localhost:3047
screteKey=replace-with-a-long-random-secret

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-password
DB_DATABASE=kewoz

# Aplicación
IS_CLIENT=false
IS_MSG91_ENABLED=false
IS_TWILIO_ENABLED=false
JWT_EXPIRY=1d
APP_NAME=Kewoz
REACT_APP_VERSION=development

# Twilio — completar solo si IS_TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# MSG91 — completar solo si IS_MSG91_ENABLED=true
MSG91_API_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# OneSignal (opcional)
ONE_SIGNAL_API_KEY=
ONE_SIGNAL_APP_ID=
ONE_SIGNAL_API_KEY_BUSINESS=
ONE_SIGNAL_APP_ID_BUSINESS=

# Canales Android (opcional)
ANDROID_CHANNEL_ID=
ANDROID_CHANNEL_ID_BUSINESS=
