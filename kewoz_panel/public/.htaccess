# Kewoz Admin - Production optimizations

# Compresion on-the-fly con mod_deflate
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/wasm application/font-woff2
</IfModule>

<IfModule mod_headers.c>
  # Cache 1 ano para assets hasheados de Vite
  <FilesMatch "\.(js|css|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML siempre revalidar
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Imagenes 30 dias
  <FilesMatch "\.(png|jpg|jpeg|svg|webp|ico|gif)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# NO servir pre-comprimidos .gz/.br - causa problemas de content-encoding
# Confiamos en mod_deflate para comprimir on-the-fly (es ~95% tan eficiente)

# SPA fallback
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
